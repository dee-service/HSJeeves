<Project Sdk="Microsoft.NET.Sdk">

  <!-- HSJeeves tray app. See design/hsjeeves-app.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HSJeeves</AssemblyName>
    <RootNamespace>HSJeeves</RootNamespace>
    <Version>0.1.2</Version>
    <!-- Without this the SDK appends "+<git hash>" to the product version (tray menu, User-Agent). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\HSJeeves.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded so the tray icon can load it at runtime. -->
    <EmbeddedResource Include="Assets\HSJeeves.ico" LogicalName="HSJeeves.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Memory reader: HSMagic NuGet package from dee-service/HS-Magic (GitHub Packages; see nuget.config and docs/build.md). -->
    <PackageReference Include="HSMagic" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
