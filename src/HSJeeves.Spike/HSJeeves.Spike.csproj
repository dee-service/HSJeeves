<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: prove HearthMirror works standalone (no HDT in-process). See design/hsjeeves-app.md, milestone 1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HSJeeves.Spike</AssemblyName>
    <RootNamespace>HSJeeves.Spike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HSMagic" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
