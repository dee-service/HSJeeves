<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: prove HearthMirror works standalone (no HDT in-process). See design/hsjeeves-app.md, milestone 1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HSJeeves.Spike</AssemblyName>
    <RootNamespace>HSJeeves.Spike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied locally (Private=true) so the spike runs without HDT installed. -->
    <!-- HearthMirror replacement from the HS-Magic project (UnitySpy based), see docs/build.md. -->
    <Reference Include="HsMagic.HearthMirrorCompat"><HintPath>..\lib_compat\HsMagic.HearthMirrorCompat.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\lib\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>

</Project>
