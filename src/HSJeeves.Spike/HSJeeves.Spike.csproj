<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: prove HearthMirror works standalone (no HDT in-process). See design/hsjeeves-app.md, milestone 1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>HSJeeves.Spike</AssemblyName>
    <RootNamespace>HSJeeves.Spike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied locally (Private=true) so the spike runs without HDT installed. -->
    <Reference Include="HearthMirror"><HintPath>..\lib\HearthMirror.dll</HintPath></Reference>
    <Reference Include="untapped-scry-dotnet"><HintPath>..\lib\untapped-scry-dotnet.dll</HintPath></Reference>
    <Reference Include="System.Reflection.DispatchProxy"><HintPath>..\lib\System.Reflection.DispatchProxy.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\lib\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>

</Project>
